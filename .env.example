# Token del bot de Telegram (te lo da @BotFather)
TELEGRAM_BOT_TOKEN=

# ID de tu chat/usuario de Telegram autorizado a usar el bot (evita que cualquiera lo use)
# Puedes obtenerlo hablando con @userinfobot en Telegram
TELEGRAM_ALLOWED_USER_ID=

# URL pública del servicio (la de Cloud Run) usada para registrar el webhook de Telegram
# Ejemplo: https://jc-analistas-bot-xxxxx-uc.a.run.app
PUBLIC_URL=

# Ruta secreta del webhook (cualquier cadena aleatoria, se usa como parte de la URL)
WEBHOOK_SECRET_PATH=

# Puerto interno del servidor (Cloud Run lo inyecta automáticamente como PORT)
PORT=8080

# Ruta al storageState.json generado con `npm run gemini:login`
# En Cloud Run normalmente vendrá montado desde Secret Manager, ver README
GEMINI_STORAGE_STATE_PATH=./storage/gemini-session.json

# Minutos máximos de espera para que Gemini termine un Deep Research antes de abortar
DEEP_RESEARCH_TIMEOUT_MINUTES=20
