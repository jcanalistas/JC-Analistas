# Token del bot de Telegram (te lo da @BotFather)
TELEGRAM_BOT_TOKEN=

# ID de tu chat/usuario de Telegram autorizado a usar el bot (evita que cualquiera lo use)
# Puedes obtenerlo hablando con @userinfobot en Telegram
TELEGRAM_ALLOWED_USER_ID=

# ID de tu canal de Telegram donde se publican los montajes al pulsar
# "Publicar en canal". El bot debe ser administrador de ese canal con
# permiso de publicar mensajes. Consíguelo reenviando un mensaje del canal
# a @userinfobot (suele ser algo como -1001234567890).
TELEGRAM_CHANNEL_ID=

# URL pública del servicio (la de Cloud Run) usada para registrar el webhook de Telegram
# Ejemplo: https://jc-analistas-bot-xxxxx-uc.a.run.app
PUBLIC_URL=

# Ruta secreta del webhook (cualquier cadena aleatoria, se usa como parte de la URL)
WEBHOOK_SECRET_PATH=

# Puerto interno del servidor (Cloud Run lo inyecta automáticamente como PORT)
PORT=8080

# API key de Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Agente de Deep Research a usar. "preview" es más rápido, "max-preview"
# es más exhaustivo pero más lento. Ver https://ai.google.dev/gemini-api/docs/deep-research
GEMINI_DEEP_RESEARCH_AGENT=deep-research-preview-04-2026

# Minutos máximos de espera para que Gemini termine un Deep Research antes de abortar
DEEP_RESEARCH_TIMEOUT_MINUTES=20

# Cadena aleatoria (cualquiera, tú la inventas) que autoriza la llamada al
# endpoint /internal/auto-analizar-tenis desde Cloud Scheduler, para el
# /analizar de tenis automático de las 7:00. Ver README para el comando
# de gcloud scheduler que la usa.
AUTO_ANALIZAR_SECRET=
